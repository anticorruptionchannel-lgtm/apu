# GEMINI_API_KEY: Required for Gemini AI (Scriptwriting, AI Image Generation, TTS Speech).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# FREE VIDEO APIS
# ==========================================
# Pexels API: Free HD/4K stock video clips (https://www.pexels.com/api/)
PEXELS_API_KEY=""
# Pixabay API: Free stock videos & footage (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=""
# Coverr API: Free high-quality stock videos (https://coverr.co/api)
COVERR_API_KEY=""

# ==========================================
# FREE IMAGE & PHOTO APIS
# ==========================================
# Unsplash API: Free high-resolution photos (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=""
# Image Gen API (e.g. OpenAI DALL-E or Stability AI)
IMAGE_GEN_API_KEY=""
# Note: Pollinations.ai requires no key (https://image.pollinations.ai/prompt/<PROMPT>)

# ==========================================
# FREE AUDIO & TTS APIS
# ==========================================
# ElevenLabs API: Voiceover synthesis (Free 10,000 chars/mo per key - https://elevenlabs.io)
# When set, used as the primary narration voice (eleven_v3 model — supports Urdu and
# Punjabi) with Gemini TTS as the fallback. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# Optional: multiple keys (e.g. separate free accounts) for more combined monthly
# characters — comma-separated, takes priority over ELEVENLABS_API_KEY above. The app
# sticks with one key until its quota is actually exhausted, then rotates to the next.
# ELEVENLABS_API_KEYS="key1,key2,key3"
# Optional: override the default premade voice ("Sarah"). Find voice IDs your account
# can actually use via GET https://api.elevenlabs.io/v1/voices, or the voice library UI:
# https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=""
# HuggingFace Token: Access free AI audio/voice models (https://huggingface.co/settings/tokens)
HF_TOKEN=""
# Zapsplat API: Free sound effects & music (https://www.zapsplat.com/api)
ZAPSPLAT_API_KEY=""

# ==========================================
# AUTO-POST TO SOCIAL MEDIA (via Zapier webhooks)
# ==========================================
# Each is the "Catch Hook" URL from a Zap you create in Zapier's own editor:
# Trigger = "Webhooks by Zapier" -> "Catch Hook", Action = that platform's publish
# action, mapping its caption/image fields from this webhook's `caption` and
# `imageUrl` JSON fields. Exact step-by-step setup: see LOCAL_SETUP_GUIDE.txt.
ZAPIER_WEBHOOK_FACEBOOK=""
ZAPIER_WEBHOOK_INSTAGRAM=""
ZAPIER_WEBHOOK_LINKEDIN=""
